{
  "name": "opencode-anti-slop",
  "version": "0.1.9",
  "description": "OpenCode enforcement kit: agent skills plus deterministic gates that keep AI-generated React and Node code modular, DRY, and documented",
  "license": "MIT",
  "type": "module",
  "bin": "install.mjs",
  "files": [
    "install.mjs",
    "templates",
    "scripts/anti-slop",
    ".opencode"
  ],
  "keywords": [
    "opencode",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "react",
    "nodejs",
    "typescript",
    "code-quality",
    "dry",
    "technical-debt",
    "lint",
    "git-hooks",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperbolictonic/opencode-anti-slop.git"
  },
  "homepage": "https://github.com/hyperbolictonic/opencode-anti-slop#readme",
  "bugs": "https://github.com/hyperbolictonic/opencode-anti-slop/issues",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/anti-slop/lib.test.mjs scripts/anti-slop/cli.test.mjs scripts/anti-slop/check-imports.test.mjs scripts/anti-slop/run-project-checks.test.mjs scripts/anti-slop/check-docs-links.test.mjs presets/presets.test.mjs",
    "gates": "node scripts/anti-slop/check-modularity.mjs --src scripts/anti-slop && node scripts/anti-slop/check-imports.mjs --src scripts && node scripts/anti-slop/check-docs.mjs --src scripts/anti-slop && node scripts/anti-slop/check-duplicates.mjs --src scripts",
    "index": "node scripts/anti-slop/generate-component-index.mjs --src scripts"
  }
}
